# Copy this file to .env and adjust the values before running docker compose.
# Hostnames below are the docker-compose service names and must not be
# changed unless the corresponding service in docker-compose.yml is renamed.

# Inventory
INVENTORY_PORT=8080
INVENTORY_DB_HOST=inventory-database
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=movies_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change_me

# Billing
BILLING_DB_HOST=billing-database
BILLING_DB_PORT=5432
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change_me

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=crud_master
RABBITMQ_PASSWORD=change_me
RABBITMQ_QUEUE=billing_queue

# API Gateway
GATEWAY_PORT=3000
INVENTORY_API_URL=http://inventory-app:8080
GATEWAY_LOG_DIR=/var/log/api-gateway
